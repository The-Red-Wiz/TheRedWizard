<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">301</defaultcontrol>
	<coordinates>
		<left>40</left>
		<top>30</top>
	</coordinates>
	<animation effect="fade" time="200">WindowOpen</animation>
	<animation effect="fade" time="200">WindowClose</animation>
	<controls>
		<control type="image">
			<description>Blank background</description>
			<width>1200</width>
			<height>660</height>
			<texture colordiffuse="FF111111">white.png</texture>
			<bordertexture border="2" colordiffuse="FF333333">white.png</bordertexture>
			<bordersize>2</bordersize>
		</control>
		<control type="textbox" id="300">
			<description>Log text</description>
			<top>20</top>
			<left>20</left>
			<width>1140</width>
			<height>580</height>
			<font>font12</font>
			<align>left</align>
			<aligny>top</aligny>
			<textcolor>white</textcolor>
			<shadowcolor>black</shadowcolor>
			<pagecontrol>301</pagecontrol>
			<autoscroll>false</autoscroll>
		</control>
		<control type="scrollbar" id="301">
			<description>Log scrollbar</description>
			<left>1170</left>
			<top>20</top>
			<width>14</width>
			<height>580</height>
			<visible>true</visible>
			<texturesliderbackground colordiffuse="FF333333">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="FF888888">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="FFFFD700">white.png</texturesliderbarfocus>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onup>301</onup>
			<ondown>302</ondown>
			<onleft>302</onleft>
			<onright>302</onright>
		</control>
		<control type="button" id="302">
			<left>1105</left>
			<top>610</top>
			<description>Close</description>
			<width>75</width>
			<height>37</height>
			<texturefocus colordiffuse="gold">close.png</texturefocus>
			<texturenofocus colordiffuse="grey">close.png</texturenofocus>
			<bordersize>5</bordersize>
			<onup>301</onup>
			<onleft>301</onleft>
			<onright>301</onright>
		</control>
	</controls>
</window>
