<?xml version="1.0" encoding="UTF-8"?>
<window>
    <!-- Opaque Autoscrape handoff cover: sits under sources_results / resolve so Home never shows. -->
    <controls>
        <control type="group">
            <width>1920</width>
            <height>1080</height>
            <control type="image">
                <texture colordiffuse="FF000000">redlight_common/white.png</texture>
            </control>
            <control type="image">
                <texture>$INFO[Window.Property(fanart)]</texture>
                <aspectratio>scale</aspectratio>
                <animation effect="fade" end="25" time="0">WindowOpen</animation>
            </control>
        </control>
        <control type="group">
            <control type="image">
                <left>5</left>
                <top>5</top>
                <width>60</width>
                <height>60</height>
                <aspectratio aligny="top">keep</aspectratio>
                <texture>$INFO[Window(10000).Property(redlight.addon_icon_mini)]</texture>
            </control>
            <control type="label">
                <left>70</left>
                <top>22</top>
                <width>800</width>
                <height>20</height>
                <font>font10</font> <!-- REDLIGHT_21 -->
                <textcolor>FFFFFFFF</textcolor>
                <align>left</align>
                <aligny>center</aligny>
                <label>[UPPERCASE]Next Episode[/UPPERCASE]</label>
            </control>
            <control type="image">
                <left>760</left>
                <top>180</top>
                <width>400</width>
                <height>600</height>
                <aspectratio>keep</aspectratio>
                <texture background="true">$INFO[Window.Property(poster)]</texture>
            </control>
            <control type="image">
                <left>395</left>
                <top>800</top>
                <width>1130</width>
                <height max="80">auto</height>
                <aspectratio>keep</aspectratio>
                <align>center</align>
                <texture background="true">$INFO[Window.Property(clearlogo)]</texture>
                <visible>!String.IsEmpty(Window.Property(clearlogo))</visible>
            </control>
            <control type="label">
                <top>800</top>
                <width>1920</width>
                <height>40</height>
                <font>font14</font> <!-- REDLIGHT_33 -->
                <textcolor>FFCCCCCC</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <label>[B]$INFO[Window.Property(title)][/B]</label>
                <visible>String.IsEmpty(Window.Property(clearlogo))</visible>
            </control>
            <control type="label">
                <top>850</top>
                <width>1920</width>
                <height>36</height>
                <font>font13</font> <!-- REDLIGHT_30 -->
                <textcolor>FFB7B4BB</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <label>$INFO[Window.Property(episode_line)]</label>
            </control>
        </control>
    </controls>
</window>
