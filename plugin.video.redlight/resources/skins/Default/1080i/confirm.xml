<?xml version="1.0" encoding="UTF-8"?>
<window>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF000000">redlight_common/white.png</texture>
            <animation effect="fade" end="85" time="120">WindowOpen</animation>
        </control>
        <control type="group">
            <left>570</left>
            <top>300</top>
            <animation effect="fade" end="100" time="200">WindowOpen</animation>
            <control type="image">
                <height>478</height>
                <width>778</width>
                <texture colordiffuse="$INFO[Window(10000).Property(redlight.window_theme)]" border="30">redlight_common/circle.png</texture>
            </control>
            <control type="image">
                <left>7</left>
                <top>7</top>
                <width>45</width>
                <height>45</height>
                <align>left</align>
                <aspectratio aligny="top">keep</aspectratio>
                <texture>$INFO[Window(10000).Property(redlight.addon_icon_mini)]</texture>
            </control>
            <control type="label">
                <width max="560">auto</width>
                <top>10</top>
                <left>110</left>
                <height>20</height>
                <font>font12</font> <!-- REDLIGHT_26 -->
                <textcolor>FFCCCCCC</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <align>center</align>
                <label>[UPPERCASE][B]$INFO[Window.Property(heading)][/B][/UPPERCASE]</label>
            </control>
            <control type="textbox" id="2000">
                <left>40</left>
                <top>60</top>
                <width>690</width>
                <height>300</height>
                <font>font13</font> <!-- REDLIGHT_30 -->
                <textcolor>FFCCCCCC</textcolor>
                <align>left</align>
                <aligny>top</aligny>
                <label>$INFO[Window.Property(text)]</label>
                <pagecontrol>2070</pagecontrol>
                <autoscroll>false</autoscroll>
            </control>
            <control type="scrollbar" id="2070">
                <visible>String.IsEqual(Window.Property(scroll),true)</visible>
                <left>735</left>
                <top>60</top>
                <width>10</width>
                <height>300</height>
                <texturesliderbackground colordiffuse="FF1F2020">redlight_common/white.png</texturesliderbackground>
                <texturesliderbar colordiffuse="FF555556">redlight_common/white.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="FFCCCCCC">redlight_common/white.png</texturesliderbarfocus>
                <onleft>2070</onleft>
                <onright>2070</onright>
                <ondown condition="String.IsEqual(Window.Property(default_control),11)">3011</ondown>
                <ondown>3010</ondown>
                <showonepage>false</showonepage>
                <orientation>vertical</orientation>
            </control>
            <control type="grouplist" id="3000">
                <left>25</left>
                <top>380</top>
                <width>728</width>
                <height>70</height>
                <orientation>horizontal</orientation>
                <itemgap>12</itemgap>
                <onup>2070</onup>
                <control type="button" id="3010">
                    <description>True</description>
                    <width>358</width>
                    <width condition="String.IsEqual(Window.Property(show_third_button),true)">234</width>
                    <height>70</height>
                    <label>$INFO[Window.Property(ok_label)]</label>
                    <font>font12</font> <!-- REDLIGHT_26 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <focusedcolor>FF1F2020</focusedcolor>
                    <texturefocus colordiffuse="CCCCCCCC" border="30">redlight_common/circle.png</texturefocus>
                    <texturenofocus colordiffuse="$INFO[Window(10000).Property(redlight.window_theme_contrast)]" border="30">redlight_common/circle.png</texturenofocus>
                    <align>center</align>
                    <aligny>center</aligny>
                </control>
                <control type="button" id="3011">
                    <description>False</description>
                    <width>358</width>
                    <width condition="String.IsEqual(Window.Property(show_third_button),true)">234</width>
                    <height>70</height>
                    <label>$INFO[Window.Property(cancel_label)]</label>
                    <font>font12</font> <!-- REDLIGHT_26 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <focusedcolor>FF1F2020</focusedcolor>
                    <texturefocus colordiffuse="CCCCCCCC" border="30">redlight_common/circle.png</texturefocus>
                    <texturenofocus colordiffuse="$INFO[Window(10000).Property(redlight.window_theme_contrast)]" border="30">redlight_common/circle.png</texturenofocus>
                    <align>center</align>
                    <aligny>center</aligny>
                </control>
                <control type="button" id="3012">
                    <description>Third</description>
                    <visible>String.IsEqual(Window.Property(show_third_button),true)</visible>
                    <width>234</width>
                    <height>70</height>
                    <label>$INFO[Window.Property(third_label)]</label>
                    <font>font12</font> <!-- REDLIGHT_26 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <focusedcolor>FF1F2020</focusedcolor>
                    <texturefocus colordiffuse="CCCCCCCC" border="30">redlight_common/circle.png</texturefocus>
                    <texturenofocus colordiffuse="$INFO[Window(10000).Property(redlight.window_theme_contrast)]" border="30">redlight_common/circle.png</texturenofocus>
                    <align>center</align>
                    <aligny>center</aligny>
                </control>
            </control>
        </control>
    </controls>
</window>
